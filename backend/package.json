{
  "name": "@prompt-vault/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && tsx --test test/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:create": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.4",
    "helmet": "^8.1.0",
    "pino": "^9.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6"
  }
}
